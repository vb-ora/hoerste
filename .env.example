# Kopieren nach .env und Werte setzen. .env niemals committen.

# Langer Zufallswert, z. B.: python -c "import secrets; print(secrets.token_urlsafe(48))"
HOERSTE_SECRET_KEY=bitte-ersetzen

# Superadmin, wird beim Start angelegt bzw. aktualisiert
HOERSTE_SUPERADMIN_NAME=bora
# Hash erzeugen: python -c "import bcrypt; print(bcrypt.hashpw(b'MEIN-PASSWORT', bcrypt.gensalt()).decode())"
# WICHTIG: In .env für Docker Compose jedes $ verdoppeln ($$)
HOERSTE_SUPERADMIN_PASSWORT_HASH=$$2b$$12$$bitte-ersetzen

# true auf der NAS (HTTPS), false nur für lokale Entwicklung über http://localhost
HOERSTE_COOKIE_SECURE=true

# Anzahl der Startup-Backups, die erhalten bleiben
HOERSTE_BACKUPS_BEHALTEN=10

# Gültigkeit von Einladungslinks in Tagen
HOERSTE_EINLADUNG_TAGE=7
